# ---- Database: choose ONE ----
# Firebase / Firestore (see firebase/README.md): paste the service-account key JSON (or its base64)
FIREBASE_SERVICE_ACCOUNT=
# Supabase (see supabase/migrations): Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: force a backend (firestore | supabase). Default: firestore if FIREBASE_SERVICE_ACCOUNT is set.
# DB_PROVIDER=

# Auth (required on Vercel)
JWT_SECRET=replace-with-a-long-random-string
TOKEN_TTL_HOURS=24

# First admin account (created on the first request if it doesn't exist)
ADMIN_EMAIL=admin@tradev.local
ADMIN_PASSWORD=ChangeMe123!

# Protects /api/cron (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=replace-with-another-long-random-string

# App
PORT=3000
STARTING_BALANCE=10000
# Seconds between saved market updates (default 5 on Firestore, 1 on Supabase). Higher = fewer database writes.
# ADVANCE_MIN_SECONDS=
# Local server only: also advance markets in the background every N ms (0 = only on requests, like Vercel)
LOCAL_TICK_MS=0

# Google Sheets public market data (optional) — see integrations/google-sheets/README.md
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=
SHEETS_SYNC_SECONDS=60
SHEETS_INCLUDE_STATS=false
