# Supabase — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-sb_secret-key

# Auth
JWT_SECRET=replace-with-a-long-random-string
TOKEN_TTL_HOURS=24

# First admin account (created on first start if it doesn't exist)
ADMIN_EMAIL=admin@tradev.local
ADMIN_PASSWORD=ChangeMe123!

# App
PORT=3000
STARTING_BALANCE=10000
TICK_MS=1000

# Google Sheets public market data (optional) — see integrations/google-sheets/README.md
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=
SHEETS_SYNC_SECONDS=60
SHEETS_INCLUDE_STATS=false
