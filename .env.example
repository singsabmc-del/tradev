# Supabase — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-sb_secret-key

# Auth (required on Vercel)
JWT_SECRET=replace-with-a-long-random-string
TOKEN_TTL_HOURS=24

# First admin account (created on the first request if it doesn't exist)
ADMIN_EMAIL=admin@tradev.local
ADMIN_PASSWORD=ChangeMe123!

# Protects /api/cron (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=replace-with-another-long-random-string

# App
PORT=3000
STARTING_BALANCE=10000
# Local server only: also advance markets in the background every N ms (0 = only on requests, like Vercel)
LOCAL_TICK_MS=0

# Google Sheets public market data (optional) — see integrations/google-sheets/README.md
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=
SHEETS_SYNC_SECONDS=60
SHEETS_INCLUDE_STATS=false
